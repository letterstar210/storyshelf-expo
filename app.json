{
  "expo": {
    "name": "Comic Reading Tracker",
    "slug": "reading-mobile-working",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "./plugins/withCleartextTraffic"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99d04c97-35ac-4277-8cec-bbe95581dfea",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff8ef"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zerod.readingapp",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff0e2"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "99d04c97-35ac-4277-8cec-bbe95581dfea"
      }
    },
    "owner": "letterstar"
  }
}
