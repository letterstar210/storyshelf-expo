{
  "name": "reading-mobile-working",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "run:pc": "powershell -ExecutionPolicy Bypass -File ./scripts/run-expo-web.ps1",
    "generate:default-library": "node scripts/generate-default-library.mjs",
    "ota:preview": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-ota-update.ps1 -Channel preview",
    "ota:production": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-ota-update.ps1 -Channel production",
    "publish:preview": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-ota-update.ps1 -Channel preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-media-library": "~18.2.1",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
